{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@remix-run/node", "vite/client"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@reactflow/packages/core/src/*": ["./node_modules/@reactflow/core/dist/esm/*"],
      "@reactflow/packages/minimap/src/*": ["./node_modules/@reactflow/minimap/dist/esm/*"],
      "@reactflow/packages/controls/src/*": ["./node_modules/@reactflow/controls/dist/esm/*"],
      "@reactflow/packages/background/src/*": ["./node_modules/@reactflow/background/dist/esm/*"],
      "@reactflow/packages/node-resizer/src/*": ["./node_modules/@reactflow/node-resizer/dist/esm/*"],
      "@reactflow/packages/node-toolbar/src/*": ["./node_modules/@reactflow/node-toolbar/dist/esm/*"]
    },
    "noEmit": true
  }
}
