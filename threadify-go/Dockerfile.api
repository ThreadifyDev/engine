# Build stage
FROM golang:1.26-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy all necessary files for go mod download
COPY shared/ ./shared/
COPY config/ ./config/
COPY api/ ./api/

# Set working directory to api and download dependencies
WORKDIR /app/api
RUN go mod download

# Build the application with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build \
    -a -installsuffix cgo \
    -ldflags="-s -w" \
    -trimpath \
    -o /app/bin/server cmd/server/main.go

# Final stage - using distroless for minimal size
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

# Copy the binary, RBAC files, config files, and code samples (distroless already runs as nonroot user)
COPY --from=builder /app/bin/server /app/server
COPY --from=builder /app/shared/rbac /app/shared/rbac
COPY --from=builder /app/api/code_samples /app/code_samples
COPY --from=builder /app/config/subscription.yaml /app/config/subscription.yaml

# Expose ports
EXPOSE 8081 3001

# Health check using the binary itself (no wget needed)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/app/server", "-healthcheck"]

# Run the application
ENTRYPOINT ["/app/server"]
