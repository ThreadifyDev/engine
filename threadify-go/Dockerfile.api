# syntax=docker/dockerfile:1

# Build on the host architecture and cross-compile for each Buildx target.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

# Set working directory
WORKDIR /app

# The gateway is a standalone standard-library-only module.
COPY api/ ./api/

# No shared module, dependency downloads or database assets are needed.
WORKDIR /app/api

# Build the application with optimizations
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -ldflags="-s -w" \
    -trimpath \
    -o /app/bin/server ./cmd/server

# Final stage - using distroless for minimal size
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

# Gateway runtime has no RBAC files, database schema, prompts or customer config.
COPY --from=builder /app/bin/server /app/server
EXPOSE 8081

# Health check using the binary itself (no wget needed)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/app/server", "-healthcheck"]

# Run the application
ENTRYPOINT ["/app/server"]
