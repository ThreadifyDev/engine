# Build stage
FROM golang:1.24-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy shared directory first (required by api module's replace directive)
COPY shared/ ./shared/

# Copy api module files
COPY api/go.mod api/go.sum ./api/

# Set working directory to api
WORKDIR /app/api

# Download dependencies
RUN go mod download

# Copy api source code
COPY api/ ./

# Build the application with optimizations
RUN CGO_ENABLED=0 GOOS=linux go build \
    -a -installsuffix cgo \
    -ldflags="-s -w" \
    -trimpath \
    -o /app/bin/server cmd/server/main.go

# Final stage - using distroless for minimal size
FROM gcr.io/distroless/static-debian12:nonroot

WORKDIR /app

# Copy the binary, RBAC files, and code samples (distroless already runs as nonroot user)
COPY --from=builder /app/bin/server /app/server
COPY --from=builder /app/shared/rbac /app/shared/rbac
COPY --from=builder /app/api/code_samples /app/code_samples

# Expose ports
EXPOSE 8081 3001

# Health check using the binary itself (no wget needed)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/app/server", "-healthcheck"]

# Run the application
ENTRYPOINT ["/app/server"]
