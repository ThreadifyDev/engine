# syntax=docker/dockerfile:1

# Build on the host architecture and cross-compile for each Buildx target.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

ARG TARGETOS
ARG TARGETARCH

# Install build dependencies
RUN apk add --no-cache git make

# Set working directory
WORKDIR /app

# Copy go mod files and shared directory (required by replace directive)
COPY go.mod go.sum ./
COPY shared/ ./shared/

# Download dependencies
RUN --mount=type=cache,target=/go/pkg/mod go mod download

# Copy source code
COPY . .

# Build the archiver application
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -trimpath \
    -o bin/archiver ./cmd/archiver

# Final stage
FROM alpine:3.21

# Install ca-certificates for HTTPS
RUN apk --no-cache add ca-certificates

# Create non-root user
RUN addgroup -g 1001 -S archiver && \
    adduser -S archiver -u 1001

WORKDIR /app

# Copy the binary from builder
COPY --from=builder /app/bin/archiver .

# Copy shared RBAC files (required by shared config package)
COPY --from=builder /app/shared/rbac ./shared/rbac

# Note: config.yaml is NOT copied - it must be mounted as a volume in production
# This ensures the archiver always uses the production config from the host

# Set proper ownership
RUN chown -R archiver:archiver /app

# Switch to non-root user
USER archiver

# Health check - archiver doesn't expose HTTP, so check if process is running
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD pgrep -x archiver || exit 1

# Run the application
CMD ["./archiver", "-config", "config/config.yaml"]
