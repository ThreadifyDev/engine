{
  "dashboard": {
    "title": "Threadify Overview",
    "tags": ["threadify", "overview"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Thread Creation Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "rate(threadify_threads_created_total[5m])",
            "legendFormat": "Threads/sec",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "WebSocket Request Duration (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(threadify_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{action}} p95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Active WebSocket Connections",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
        "targets": [
          {
            "expr": "threadify_active_connections",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "API Key Cache Hit Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
        "targets": [
          {
            "expr": "rate(threadify_api_key_cache_hits_total[5m]) / (rate(threadify_api_key_cache_hits_total[5m]) + rate(threadify_api_key_cache_misses_total[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 5,
        "title": "Request Success Rate",
        "type": "stat",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8},
        "targets": [
          {
            "expr": "sum(rate(threadify_requests_total{status=\"success\"}[5m])) / sum(rate(threadify_requests_total[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 6,
        "title": "Archiver Stream Messages Consumed",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "rate(threadify_archiver_stream_messages_consumed_total[5m])",
            "legendFormat": "{{stream}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Database Write Latency (p95)",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(threadify_archiver_database_write_duration_seconds_bucket[5m]))",
            "legendFormat": "{{table}} p95",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
